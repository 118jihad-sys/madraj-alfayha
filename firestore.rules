rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return verified()
        && request.auth.token.email == '118jihad@gmail.com';
    }
    function isNewsEditor() {
      return verified()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data.role == 'newsEditor';
    }
    match /site/data {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site/news {
      allow read: if true;
      allow write: if isAdmin() || isNewsEditor();
    }
    match /userRoles/{email} {
      allow read: if isAdmin()
        || (verified() && request.auth.token.email == email);
      allow write: if isAdmin();
    }
  }
}

